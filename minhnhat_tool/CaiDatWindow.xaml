                        </StackPanel>
                    </Border>

                    <Border Background="#111827" CornerRadius="12" Padding="18">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TieuDe}" Text="Khóa API"/>
                            <TextBlock Foreground="#94a3b8" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="Dùng chung một khóa cho cả hạn mức cào nền lẫn kiểm tra nhà cung cấp. Nhập ở tab &quot;Kiểm tra NCC&quot;."/>
