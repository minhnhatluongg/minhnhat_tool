<Window x:Class="minhnhat_tool.CaiDatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:minhnhat_tool.Ui"
        Title="Cài đặt — Cào nền, Kho dữ liệu &amp; Gói dịch vụ" Height="800" Width="1060"
        Icon="app.ico" WindowStartupLocation="CenterOwner" Background="#0b0f1a">

    <Window.Resources>

        <!-- Tab header tối màu, gạch chân xanh khi đang chọn -->

        <!-- ===== Dark ComboBox ===== -->


        <!-- ===== Dark DatePicker ===== -->



        <Style x:Key="Nhan" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TieuDe" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#22d3ee"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="ThHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0f172a"/>
            <Setter Property="Foreground" Value="#22c55e"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="OGiua" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="OPhai" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <TabControl x:Name="tabs" Background="#0b0f1a" BorderThickness="0" Margin="10"
                SelectionChanged="tabs_SelectionChanged">

        <!-- ============ TAB 1: CÀO NỀN ============ -->
        <TabItem Header="Cào nền" ui:Ic.Glyph="{StaticResource IcCaoNen}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                <StackPanel Margin="8">

                    <Border Background="#111827" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Path Style="{StaticResource IconNet}" Data="{StaticResource IcCaoNen}"
                                      Stroke="#22D3EE" Width="17" Height="17"/>
                                <TextBlock Style="{StaticResource TieuDe}" Text="Tải sẵn hóa đơn về máy (cào nền)" Margin="9,0,0,0"/>
                            </StackPanel>
                            <TextBlock Foreground="#94a3b8" TextWrapping="Wrap" Margin="0,0,0,14"
                                       Text="Lúc rảnh, app tự tải chi tiết + XML của hóa đơn về máy bạn. Sáng ra xuất Excel/PDF gần như tức thì. Dữ liệu nằm HOÀN TOÀN trên máy này, không gửi đi đâu."/>

                            <CheckBox x:Name="chkBat" Content="  Bật cào nền tự động"
                                      Foreground="#e2e8f0" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Giờ chạy mỗi ngày:" Style="{StaticResource Nhan}" Width="150"/>
                                <ComboBox x:Name="cboGio" Width="110"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- CÀO GÌ -->
                    <Border Background="#111827" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="24" Height="24" CornerRadius="12" Background="#1E3A5F"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="1" Foreground="#22D3EE" FontWeight="Bold" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Style="{StaticResource TieuDe}" Text="Cào loại hóa đơn nào?" Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <CheckBox x:Name="chkMuaVao" Foreground="#e2e8f0" FontSize="16" Margin="0,0,0,8"
                                      Content="  Hóa đơn ĐẦU VÀO (mua vào) — dùng để kê khai khấu trừ"/>
                            <CheckBox x:Name="chkBanRa" Foreground="#e2e8f0" FontSize="16" Margin="0,0,0,8"
                                      Content="  Hóa đơn ĐẦU RA (bán ra) — hóa đơn công ty bạn phát hành"/>
                            <CheckBox x:Name="chkXml" Foreground="#e2e8f0" FontSize="16" Margin="0,4,0,0"
                                      Content="  Tải kèm XML gốc (bản có chữ ký số — chậm hơn khoảng gấp đôi)"/>
                            <TextBlock Foreground="#64748b" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12"
                                       Text="Chọn cả hai chiều thì thời gian cào tăng gấp đôi. Đa số kế toán chỉ cần đầu vào."/>
                        </StackPanel>
                    </Border>

                    <!-- KHOẢNG NÀO -->
                    <Border Background="#111827" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="24" Height="24" CornerRadius="12" Background="#1E3A5F"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="2" Foreground="#22D3EE" FontWeight="Bold" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Style="{StaticResource TieuDe}" Text="Trong khoảng thời gian nào?" Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Lựa chọn A: cuốn chiếu -->
                            <Border x:Name="brdGanDay" CornerRadius="10" Padding="14,12" Margin="0,0,0,10"
                                    Background="#0b1220" BorderBrush="#1e293b" BorderThickness="1">
                                <StackPanel>
                                    <RadioButton x:Name="rdGanDay" GroupName="pham_vi" Foreground="#e2e8f0" FontSize="14"
                                                 FontWeight="SemiBold" Content="  Cuốn chiếu — luôn giữ ấm N ngày gần nhất"
                                                 Checked="PhamVi_Changed"/>
                                    <TextBlock Foreground="#64748b" FontSize="12" Margin="24,4,0,10"
                                               Text="Mỗi ngày tự đẩy cửa sổ lên — hợp với kê khai định kỳ."/>
                                    <StackPanel Orientation="Horizontal" Margin="24,0,0,0">
                                        <TextBlock Text="Số ngày gần nhất:" Style="{StaticResource Nhan}" Width="130"/>
                                        <TextBox x:Name="txtSoNgay" Width="80"
                                                 HorizontalContentAlignment="Center" TextChanged="Khoang_Changed"/>
                                        <TextBlock Text="ngày" Style="{StaticResource Nhan}" Margin="8,0,16,0"/>
                                        <Button Content="45 ngày" Style="{StaticResource NutNho}" Tag="45"  Click="Preset_Click"/>
                                        <Button Content="3 tháng" Style="{StaticResource NutNho}" Tag="93"  Click="Preset_Click"/>
                                        <Button Content="6 tháng" Style="{StaticResource NutNho}" Tag="186" Click="Preset_Click"/>
                                        <Button Content="1 năm"   Style="{StaticResource NutNho}" Tag="366" Click="Preset_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Lựa chọn B: khoảng cố định -->
                            <Border x:Name="brdCoDinh" CornerRadius="10" Padding="14,12"
                                    Background="#0b1220" BorderBrush="#1e293b" BorderThickness="1">
                                <StackPanel>
                                    <RadioButton x:Name="rdCoDinh" GroupName="pham_vi" Foreground="#e2e8f0" FontSize="14"
                                                 FontWeight="SemiBold" Content="  Một khoảng cố định — cào xong một lần rồi thôi"
                                                 Checked="PhamVi_Changed"/>
                                    <TextBlock Foreground="#64748b" FontSize="12" Margin="24,4,0,10"
                                               Text="Hợp với quyết toán năm hoặc dựng lại sổ một kỳ đã qua."/>
                                    <StackPanel Orientation="Horizontal" Margin="24,0,0,10">
                                        <TextBlock Text="Từ ngày:" Style="{StaticResource Nhan}" Width="70"/>
                                        <DatePicker x:Name="dpTu" Width="150"
                                                    SelectedDateChanged="Ngay_Changed"/>
                                        <TextBlock Text="Đến ngày:" Style="{StaticResource Nhan}" Width="80" Margin="20,0,0,0"/>
                                        <DatePicker x:Name="dpDen" Width="150"
                                                    SelectedDateChanged="Ngay_Changed"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="24,0,0,0">
                                        <TextBlock Text="Chọn nhanh:" Style="{StaticResource Nhan}" Width="130"/>
                                        <Button Content="Năm nay"   Style="{StaticResource NutNho}" Tag="namnay"  Click="PresetKy_Click"/>
                                        <Button Content="Năm ngoái" Style="{StaticResource NutNho}" Tag="namngoai" Click="PresetKy_Click"/>
                                        <Button Content="Quý này"   Style="{StaticResource NutNho}" Tag="quynay"  Click="PresetKy_Click"/>
                                        <Button Content="Quý trước" Style="{StaticResource NutNho}" Tag="quytruoc" Click="PresetKy_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border x:Name="brdCanhBao" Background="#422006" BorderBrush="#b45309" BorderThickness="1"
                                    CornerRadius="8" Padding="12" Margin="0,14,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="lblGioiHan" Foreground="#fbbf24" TextWrapping="Wrap"/>
                            </Border>

                            <TextBlock x:Name="lblUocLuong" Foreground="#94a3b8" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- CHẠY -->
                    <Border Background="#111827" CornerRadius="12" Padding="18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="24" Height="24" CornerRadius="12" Background="#1E3A5F"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="3" Foreground="#22D3EE" FontWeight="Bold" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Style="{StaticResource TieuDe}" Text="Chạy" Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="lblTrangThai" Foreground="#facc15" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="btnChayNgay" Content="Chạy ngay" ui:Ic.Glyph="{StaticResource IcChay}"
                                        Background="#2563eb" Height="40" Width="150" Click="btnChayNgay_Click"/>
                                <Button x:Name="btnDungCao" Content="Dừng" ui:Ic.Glyph="{StaticResource IcDung}"
                                        Background="#dc2626" Height="40" Width="110" Margin="10,0,0,0"
                                        IsEnabled="False" Click="btnDungCao_Click"/>
                            </StackPanel>
                            <TextBlock Foreground="#64748b" TextWrapping="Wrap" Margin="0,14,0,0" FontSize="12"
                                       Text="Cào nền chỉ chạy khi app đang mở — muốn sáng nào cũng sẵn thì để app chạy qua đêm hoặc bật cùng Windows. Công ty chưa lưu mật khẩu sẽ bị bỏ qua. Bạn thao tác tay thì cào nền tự nhường."/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ============ TAB 2: THỐNG KÊ ============ -->
        <TabItem Header="Thống kê kho" ui:Ic.Glyph="{StaticResource IcThongKe}">
            <DockPanel Margin="8,14,8,8">

                <Border DockPanel.Dock="Top" Background="#111827" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Path Style="{StaticResource IconNet}" Data="{StaticResource IcThongKe}"
                                      Stroke="#22D3EE" Width="17" Height="17"/>
                                <TextBlock Style="{StaticResource TieuDe}" Text="Kho dữ liệu đang có trên máy này" Margin="9,0,0,0"/>
                            </StackPanel>
                        <TextBlock x:Name="lblTongQuan" Foreground="#e2e8f0" TextWrapping="Wrap" FontSize="13"/>
                        <TextBlock x:Name="lblCache" Foreground="#64748b" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12"/>
                    </StackPanel>
                </Border>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="btnLamMoi" Content="Làm mới" ui:Ic.Glyph="{StaticResource IcLamMoi}"
                            Background="#2563eb" Height="36" Width="130" Click="btnLamMoi_Click"/>
                    <Button x:Name="btnXoaCty" Content="Xóa dữ liệu công ty đang chọn" ui:Ic.Glyph="{StaticResource IcXoa}"
                            Background="#7c2d12" Height="36" Width="260" Margin="10,0,0,0" Click="btnXoaCty_Click"/>
                    <Button x:Name="btnXoaCache" Content="Xóa toàn bộ kho" ui:Ic.Glyph="{StaticResource IcDonKho}"
                            Background="#b45309" Height="36" Width="180" Margin="10,0,0,0" Click="btnXoaCache_Click"/>
                </StackPanel>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="210"/>
                    </Grid.RowDefinitions>

                    <Border Background="#111827" CornerRadius="12" Padding="12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Foreground="#94a3b8" Margin="0,0,0,8"
                                       Text="Theo công ty và chiều hóa đơn — bấm một dòng để xem chi tiết theo tháng"/>
                            <DataGrid x:Name="grdCty" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="Transparent" Foreground="#e2e8f0" BorderThickness="0"
                                      RowBackground="#0f172a" AlternatingRowBackground="#131c31"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1e293b"
                                      HeadersVisibility="Column" FontSize="12"
                                      ColumnHeaderStyle="{StaticResource ThHeader}"
                                      SelectionChanged="grdCty_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="MST"        Binding="{Binding Mst}"   Width="112"/>
                                    <DataGridTextColumn Header="Công ty"    Binding="{Binding Ten}"   Width="*"/>
                                    <DataGridTextColumn Header="Chiều"      Binding="{Binding Loai}"  Width="88"  ElementStyle="{StaticResource OGiua}"/>
                                    <DataGridTextColumn Header="Số HĐ"      Binding="{Binding SoHoaDon}"  Width="72" ElementStyle="{StaticResource OPhai}"/>
                                    <DataGridTextColumn Header="Chi tiết"   Binding="{Binding CoChiTiet}" Width="80" ElementStyle="{StaticResource OPhai}"/>
                                    <DataGridTextColumn Header="XML"        Binding="{Binding CoXml}" Width="68"  ElementStyle="{StaticResource OPhai}"/>
                                    <DataGridTextColumn Header="Đủ"         Binding="{Binding DayDu}" Width="62"  ElementStyle="{StaticResource OGiua}"/>
                                    <DataGridTextColumn Header="Máy TT"     Binding="{Binding Pos}" Width="78" ElementStyle="{StaticResource OPhai}"/>
                                    <DataGridTextColumn Header="Từ"         Binding="{Binding TuNgay}"  Width="98" ElementStyle="{StaticResource OGiua}"/>
                                    <DataGridTextColumn Header="Đến"        Binding="{Binding DenNgay}" Width="98" ElementStyle="{StaticResource OGiua}"/>
                                    <DataGridTextColumn Header="Tổng tiền"  Binding="{Binding TongTienHienThi}" Width="130" ElementStyle="{StaticResource OPhai}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Background="#111827" CornerRadius="12" Padding="12" Margin="0,12,0,0">
                        <DockPanel>
                            <TextBlock x:Name="lblThang" DockPanel.Dock="Top" Foreground="#94a3b8" Margin="0,0,0,8"
                                       TextWrapping="Wrap" Text="Chi tiết theo tháng"/>
                            <DataGrid x:Name="grdThang" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="Transparent" Foreground="#e2e8f0" BorderThickness="0"
                                      RowBackground="#0f172a" AlternatingRowBackground="#131c31"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1e293b"
                                      HeadersVisibility="Column" FontSize="12"
                                      ColumnHeaderStyle="{StaticResource ThHeader}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tháng"   Binding="{Binding Ky}" Width="70" ElementStyle="{StaticResource OGiua}"/>
                                    <DataGridTextColumn Header="Số HĐ"   Binding="{Binding SoHoaDon}"  Width="60" ElementStyle="{StaticResource OPhai}"/>
                                    <DataGridTextColumn Header="Chi tiết" Binding="{Binding CoChiTiet}" Width="65" ElementStyle="{StaticResource OPhai}"/>
                                    <DataGridTextColumn Header="XML"     Binding="{Binding CoXml}" Width="55" ElementStyle="{StaticResource OPhai}"/>
                                    <DataGridTextColumn Header="Đủ"      Binding="{Binding DayDu}" Width="*"  ElementStyle="{StaticResource OGiua}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </TabItem>

        <!-- ============ TAB 3: KIỂM TRA NCC ============ -->
        <TabItem Header="Kiểm tra NCC" ui:Ic.Glyph="{StaticResource IcBaoVe}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                <StackPanel Margin="8">
                    <Border Background="#111827" CornerRadius="12" Padding="18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Path Style="{StaticResource IconNet}" Data="{StaticResource IcBaoVe}"
                                      Stroke="#22D3EE" Width="17" Height="17"/>
                                <TextBlock Style="{StaticResource TieuDe}" Text="Kiểm tra tình trạng nhà cung cấp" Margin="9,0,0,0"/>
                            </StackPanel>
                            <TextBlock Foreground="#94a3b8" TextWrapping="Wrap" Margin="0,0,0,14"
                                       Text="Tra tình trạng mã số thuế của đối tác để phát hiện nhà cung cấp đã ngừng hoạt động hoặc không hoạt động tại địa chỉ đăng ký — dấu hiệu cần rà lại trước khi kê khai khấu trừ. Mỗi mã số thuế chỉ tra 1 lần dù xuất hiện ở nhiều hóa đơn."/>

                            <CheckBox x:Name="chkTuKiemTra" Content="  Tự kiểm tra ngay sau khi đồng bộ hóa đơn"
                                      Foreground="#e2e8f0" FontSize="14"/>

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button x:Name="btnThuTraCuu" Content="Thử tra cứu"
                                        Background="#2563eb" Height="36" Width="140" Click="btnThuTraCuu_Click"/>
                                <TextBlock x:Name="lblTraCuu" Foreground="#facc15" VerticalAlignment="Center"
                                           Margin="14,0,0,0" TextWrapping="Wrap" Width="560"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="brdCanKhoaNcc" Background="#1c1917" BorderBrush="#b45309" BorderThickness="1"
                            CornerRadius="12" Padding="18" Margin="0,14,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Path Style="{StaticResource IconNet}" Data="{StaticResource IcChiaKhoa}"
                                      Stroke="#FBBF24" Width="16" Height="16"/>
                                <TextBlock Text="Tính năng này cần khóa API" Foreground="#fbbf24"
                                           FontWeight="Bold" FontSize="14" Margin="9,0,0,0"/>
                            </StackPanel>
                            <TextBlock Foreground="#94a3b8" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Text="Kiểm tra nhà cung cấp dùng chung khóa với cào nền. Nhập một lần là dùng được cả hai."/>
                            <Button Content="Sang tab Khóa &amp; Hạn mức"
                                    Background="#b45309" Height="36" Width="220" HorizontalAlignment="Left"
                                    Click="btnSangTabKhoa_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ============ TAB 4: KHÓA & HẠN MỨC ============ -->
        <TabItem Header="Khóa &amp; Hạn mức" ui:Ic.Glyph="{StaticResource IcChiaKhoa}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                <StackPanel Margin="8">

                    <!-- Trạng thái hạn mức -->
                    <Border x:Name="brdHanMuc" Background="#111827" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Số tờ hóa đơn còn lại" Foreground="#94a3b8" FontSize="13"/>
                                <TextBlock x:Name="lblHanMuc" Foreground="#22c55e" FontSize="30" FontWeight="Bold"
                                           TextWrapping="Wrap" Text="—" Margin="0,2,0,0"/>
                                <TextBlock x:Name="lblHanMucPhu" Foreground="#94a3b8" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <ProgressBar x:Name="pbHanMuc" Height="8" Minimum="0" Maximum="100" Value="0"
                                             Background="#1e293b" Foreground="#22c55e" BorderThickness="0"
                                             Margin="0,12,0,0"/>
                                <TextBlock x:Name="lblHanMucChiTiet" Foreground="#64748b" FontSize="12"
                                           Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="lblHanMucLoi" Foreground="#facc15" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="btnLamMoiHanMuc" Content="Làm mới" ui:Ic.Glyph="{StaticResource IcLamMoi}"
                                    Background="#334155" Height="34" Width="120"
                                    VerticalAlignment="Top" Click="btnLamMoiHanMuc_Click"/>
                        </Grid>
                    </Border>

                    <!-- Hướng dẫn 3 bước -->
                    <Border Background="#111827" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TieuDe}" Text="Lấy khóa như thế nào"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="26" Height="26" CornerRadius="13" Background="#2563eb" VerticalAlignment="Top">
                                    <TextBlock Text="1" Foreground="White" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="Liên hệ mua số tờ hóa đơn" Foreground="#e2e8f0" FontWeight="SemiBold"/>
                                    <TextBlock Foreground="#94a3b8" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Text="Mua theo số tờ, dùng dần, không hết hạn. Bên bán cấp cho bạn một cặp API Key và API Secret."/>
                                    <TextBlock x:Name="lblLienHe" Foreground="#22d3ee" TextWrapping="Wrap"
                                               Margin="0,6,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="26" Height="26" CornerRadius="13" Background="#2563eb" VerticalAlignment="Top">
                                    <TextBlock Text="2" Foreground="White" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="Dán hai dòng nhận được vào ô bên dưới" Foreground="#e2e8f0" FontWeight="SemiBold"/>
                                    <TextBlock Foreground="#94a3b8" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Text="API Key bắt đầu bằng tk_. API Secret là dãy chữ số dài hơn. Dán đủ cả hai, không thừa dấu cách."/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="26" Height="26" CornerRadius="13" Background="#2563eb" VerticalAlignment="Top">
                                    <TextBlock Text="3" Foreground="White" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="Bấm Lưu &amp; kiểm tra" Foreground="#e2e8f0" FontWeight="SemiBold"/>
                                    <TextBlock Foreground="#94a3b8" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Text="App hỏi máy chủ ngay để xác nhận khóa dùng được và hiện số tờ còn lại. Không tốn tờ nào."/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Nhập khóa -->
                    <Border Background="#111827" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TieuDe}" Text="Khóa API"/>

                            <TextBlock Text="API Key" Style="{StaticResource Nhan}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtApiKey" Height="36" FontFamily="Consolas"
                                     TextChanged="Khoa_Changed"/>
                            <Grid Margin="0,10,0,4">
                                <TextBlock Text="API Secret" Style="{StaticResource Nhan}"/>
                                <CheckBox x:Name="chkHienKhoa" Content="Hiện" FontSize="12"
                                          HorizontalAlignment="Right" Foreground="#94a3b8"
                                          Checked="HienKhoa_Changed" Unchecked="HienKhoa_Changed"/>
                            </Grid>
                            <Grid>
                                <PasswordBox x:Name="pwdApiSecret" Height="36" FontFamily="Consolas"
                                             PasswordChanged="Khoa_Changed"/>
                                <TextBox x:Name="txtApiSecret" Height="36" FontFamily="Consolas"
                                         Visibility="Collapsed" TextChanged="Khoa_Changed"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="btnLuuKhoa" Content="Lưu &amp; kiểm tra" ui:Ic.Glyph="{StaticResource IcLuu}"
                                        Background="#16a34a" Height="38" Width="180" Click="btnLuuKhoa_Click"/>
                                <Button x:Name="btnXoaKhoa" Content="Xóa khóa"
                                        Background="#475569" Height="38" Width="110" Margin="10,0,0,0"
                                        Click="btnXoaKhoa_Click"/>
                                <TextBlock x:Name="lblKhoaKq" Foreground="#facc15" VerticalAlignment="Center"
                                           Margin="14,0,0,0" TextWrapping="Wrap" Width="440"/>
                            </StackPanel>

                            <TextBlock x:Name="lblKhoaTomTat" Foreground="#64748b" TextWrapping="Wrap"
                                       Margin="0,12,0,0" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- Cách tính tiền -->
                    <Border Background="#111827" CornerRadius="12" Padding="18">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TieuDe}" Text="Tính phí thế nào"/>
                            <TextBlock Foreground="#94a3b8" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="• Mỗi tờ hóa đơn chỉ tính tiền MỘT LẦN. Hôm nay tải 10 tờ thì trừ 10; ngày mai cào lại đúng 10 tờ đó trừ 0."/>
                            <TextBlock Foreground="#94a3b8" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="• Tờ đã có sẵn trên máy thì không xin hạn mức, không tốn gì."/>
                            <TextBlock Foreground="#94a3b8" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="• Số tờ đã mua không hết hạn. Cài lại máy hay đổi máy vẫn giữ nguyên."/>
                            <TextBlock Foreground="#94a3b8" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="• Đồng bộ và xuất Excel/PDF/XML thủ công KHÔNG tốn hạn mức — chỉ cào nền (tải sẵn ngầm) và kiểm tra nhà cung cấp mới dùng khóa."/>
                            <TextBlock Foreground="#64748b" TextWrapping="Wrap" FontSize="12"
                                       Text="Riêng tư: app chỉ gửi mã băm SHA-256 của từng tờ để đếm, không gửi nội dung hóa đơn. Máy chủ đếm chính xác nhưng không đọc được bạn tải hóa đơn của ai."/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </TabItem>

    </TabControl>
</Window>
