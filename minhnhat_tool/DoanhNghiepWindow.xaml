<Window x:Class="minhnhat_tool.DoanhNghiepWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:minhnhat_tool.Ui"
        Title="Quản lý doanh nghiệp" Height="560" Width="880"
        Icon="app.ico"
        WindowStartupLocation="CenterOwner" Background="#0B0F1A">

    <Window.Resources>
        <!-- Nhãn ô nhập: icon nhỏ + chữ, để mắt bắt được từng trường nhanh hơn đọc -->
        <Style x:Key="NhanO" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="IconNhan" TargetType="Path" BasedOn="{StaticResource IconNet}">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== TRÁI: danh sách ===== -->
        <Border Grid.Column="0" Background="#111827" CornerRadius="12" Padding="14" Margin="0,0,12,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                    <Path Style="{StaticResource IconNet}" Data="{StaticResource IcCongTy}"
                          Stroke="#22D3EE" Width="17" Height="17"/>
                    <TextBlock Text="Doanh nghiệp đã lưu" Foreground="#22D3EE" FontWeight="Bold"
                               FontSize="14" Margin="9,0,0,0" VerticalAlignment="Center"/>
                    <Border x:Name="brdDem" Background="#1E3A5F" CornerRadius="9" Padding="7,1"
                            Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="lblDem" Text="0" Foreground="#22D3EE" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <Button DockPanel.Dock="Bottom" x:Name="btnChon" ui:Ic.Glyph="{StaticResource IcTick}"
                        Content="Chọn doanh nghiệp này" Background="#2563EB" Height="44"
                        Margin="0,12,0,0" Click="btnChon_Click"/>

                <!-- Trạng thái rỗng: màn hình trắng trơn không nói cho người dùng biết phải làm gì -->
                <Grid>
                    <ListBox x:Name="lstDN" Background="Transparent" Foreground="#E2E8F0" BorderThickness="0"
                             ItemContainerStyle="{StaticResource MucDanhSach}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             FontSize="13" SelectionChanged="lstDN_SelectionChanged">
                        <!-- Hai dòng: MST là thứ để đối chiếu, tên công ty dài luôn bị cắt nếu nhét chung dòng -->
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Mst}" FontFamily="Consolas" FontSize="13"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding TenDN}" Foreground="#8B9AB4" FontSize="11"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                               ToolTip="{Binding TenDN}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="pnlTrong" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <Path Style="{StaticResource IconNet}" Data="{StaticResource IcTrong}"
                              Stroke="#334155" Width="34" Height="34" HorizontalAlignment="Center"/>
                        <TextBlock Text="Chưa lưu doanh nghiệp nào" Foreground="#64748B" FontSize="12"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        <TextBlock Text="Nhập mã số thuế bên phải rồi bấm Lưu" Foreground="#475569"
                                   FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="180"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ===== PHẢI: form ===== -->
        <Border Grid.Column="1" Background="#111827" CornerRadius="12" Padding="22">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Path Style="{StaticResource IconNet}" Data="{StaticResource IcSua}"
                          Stroke="#22D3EE" Width="17" Height="17"/>
                    <TextBlock x:Name="lblTieuDeForm" Text="Thêm doanh nghiệp" Foreground="#22D3EE"
                               FontWeight="Bold" FontSize="14" Margin="9,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <Path Style="{StaticResource IconNhan}" Data="{StaticResource IcCongTy}"/>
                    <TextBlock Text="Mã số thuế" Style="{StaticResource NhanO}"/>
                </StackPanel>
                <TextBox x:Name="txtMst" Height="42" FontFamily="Consolas" FontSize="14"
                         LostFocus="txtMst_LostFocus"/>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,5">
                    <Path Style="{StaticResource IconNhan}" Data="{StaticResource IcNguoi}"/>
                    <TextBlock Text="Tên doanh nghiệp" Style="{StaticResource NhanO}"/>
                    <TextBlock Text="— tự lấy từ Tổng cục Thuế" Foreground="#4A5670" FontSize="11"
                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBox x:Name="txtTen" Height="42" Foreground="#94A3B8" IsReadOnly="True" Focusable="False"/>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,5">
                    <Path Style="{StaticResource IconNhan}" Data="{StaticResource IcChiaKhoa}"/>
                    <TextBlock Text="Mật khẩu hoadondientu.gdt.gov.vn" Style="{StaticResource NhanO}"/>
                </StackPanel>
                <!-- Con mắt nằm TRONG ô: đỡ tốn một dòng và đúng chỗ mắt đang nhìn -->
                <Grid>
                    <PasswordBox x:Name="txtPassword" Height="42" Padding="11,0,44,0"/>
                    <TextBox x:Name="txtPasswordHien" Height="42" Padding="11,0,44,0" Visibility="Collapsed"/>
                    <Button x:Name="btnHienMk" Width="34" Height="34" HorizontalAlignment="Right"
                            Margin="0,0,5,0" Background="Transparent" Padding="0"
                            ui:Ic.Glyph="{StaticResource IcXem}" ui:Ic.Size="17"
                            ToolTip="Hiện / ẩn mật khẩu" Click="btnHienMk_Click"/>
                </Grid>
                <TextBlock Text="Mật khẩu chỉ nằm trên máy này, dùng để tự đăng nhập khi cào nền. Bỏ trống thì công ty này sẽ bị bỏ qua lúc cào nền."
                           Foreground="#4A5670" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>

                <Border Height="1" Background="#1E293B" Margin="0,20,0,18"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="btnLuu" ui:Ic.Glyph="{StaticResource IcLuu}" Content="Lưu"
                            Background="#16A34A" Height="44" Margin="0,0,6,0" Click="btnLuu_Click"/>
                    <Button Grid.Column="1" x:Name="btnXoa" ui:Ic.Glyph="{StaticResource IcXoa}" Content="Xóa"
                            Background="#B91C1C" Height="44" Margin="6,0,6,0" Click="btnXoa_Click"/>
                    <Button Grid.Column="2" x:Name="btnLamMoi" ui:Ic.Glyph="{StaticResource IcLamMoi}"
                            Content="Nhập mới" Background="#374151" Height="44" Margin="6,0,0,0"
                            Click="btnLamMoi_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
