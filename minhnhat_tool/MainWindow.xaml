<Window x:Class="minhnhat_tool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:minhnhat_tool.Ui"
        Title="Phần mềm quản lý hóa đơn" Height="780" Width="1360" MinHeight="620" MinWidth="1100"
        Icon="app.ico" Language="vi-VN"
        WindowStartupLocation="CenterScreen" Background="#0B0F1A">

    <!-- ====================================================================
         MÀN HÌNH CHÍNH

         Bố cục: vạch thương hiệu -> header (thương hiệu, doanh nghiệp, trạng thái)
         -> thanh lọc 2 hàng -> bảng hóa đơn (có dải tiêu đề + vạch tải + khung xương)
         -> chân trang 4 ô số liệu. Phủ lên trên: hộp tiến trình và thông báo nhanh.

         Khi đang tải: vạch tải chạy dưới dải tiêu đề bảng, khung xương nhấp nháy
         thay chỗ bảng trống, hộp tiến trình có spinner + phần trăm + thời gian đã chạy.
         Người dùng luôn thấy "máy đang làm" thay vì màn hình đứng im.
         ==================================================================== -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="BtnGreen" TargetType="Button" BasedOn="{StaticResource Nut}">
            <Setter Property="Background" Value="#16A34A"/>
        </Style>
        <Style x:Key="BtnOrange" TargetType="Button" BasedOn="{StaticResource Nut}">
            <Setter Property="Background" Value="#EA8A1E"/>
        </Style>
        <!-- Nút phụ: nền tối, để nút chính (xanh) nổi lên -->
        <Style x:Key="NutPhu" TargetType="Button" BasedOn="{StaticResource Nut}">
            <Setter Property="Background" Value="#1F2937"/>
        </Style>
        <!-- Nút trong bộ chọn Mua vào / Bán ra: thấp hơn, nằm trong khay bo góc -->
        <Style x:Key="NutPhan" TargetType="Button" BasedOn="{StaticResource Nut}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="#1A2437"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7C8AA5"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Canh lề nội dung ô bảng -->
        <Style x:Key="CellCenter" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CellRight" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>
        <Style x:Key="CellLeft" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Nhãn tròn (pill) trong bảng -->
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PillChu" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Đầu cột bảng: chữ mờ, gạch dưới mảnh, có mũi tên khi sắp xếp -->
        <Style x:Key="DauCot" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#8FA3BF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="Center">
                                    <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                    <Path x:Name="mui" Style="{StaticResource IconNet}" Data="{StaticResource IcXuong}"
                                          Stroke="#22D3EE" Width="10" Height="10" Margin="5,0,0,0"
                                          Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"/>
                                </StackPanel>
                            </Border>
                            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="6" Cursor="SizeWE">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#132038"/>
                                <Setter Property="Foreground" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="mui" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="mui" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="mui" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ô bảng: không viền, không khung focus; màu chọn do dòng quyết định -->
        <Style x:Key="ODuLieu" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thanh tiến trình: mảnh, bo tròn, chuyển màu xanh ngọc -> xanh lá.
             Khi chưa biết % (indeterminate): thanh mờ đi và một vệt sáng quét qua lại. -->
        <Style x:Key="ThanhTienTrinh" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Background" Value="#0B1220"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#22D3EE" Offset="0"/>
                                        <GradientStop Color="#16A34A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Rectangle x:Name="quet" RadiusX="4" RadiusY="4" Visibility="Collapsed">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <LinearGradientBrush.RelativeTransform>
                                            <TranslateTransform X="-1"/>
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Color="#0022D3EE" Offset="0"/>
                                        <GradientStop Color="#FF22D3EE" Offset="0.5"/>
                                        <GradientStop Color="#0022D3EE" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Indicator" Property="Opacity" Value="0.18"/>
                                <Setter TargetName="quet" Property="Visibility" Value="Visible"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="sbQuetBar">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="quet"
                                                             Storyboard.TargetProperty="(Shape.Fill).(Brush.RelativeTransform).(TranslateTransform.X)"
                                                             From="-1" To="1" Duration="0:0:1.3" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="sbQuetBar"/>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Animation lúc đang tải: bật/tắt từ code (ShowProgress / HideProgress / HienSkeleton).
             Không dùng trigger theo Visibility trong Style: trigger đó chạy ngay lúc áp style, khi
             Fill/RenderTransform của phần tử chưa được gán -> storyboard nổ lúc mở cửa sổ. ===== -->
        <!-- Vệt sáng quét ngang trên vạch tải dưới dải tiêu đề bảng -->
        <Storyboard x:Key="SbVachTai" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="rectTaiLine"
                             Storyboard.TargetProperty="(Shape.Fill).(Brush.RelativeTransform).(TranslateTransform.X)"
                             From="-1" To="1" Duration="0:0:1.4"/>
        </Storyboard>
        <!-- Spinner: vòng cung xoay trong hộp tiến trình -->
        <Storyboard x:Key="SbXoay" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="icoXoay"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0" To="360" Duration="0:0:0.9"/>
        </Storyboard>
        <!-- Khung xương nhấp nháy nhẹ -->
        <Storyboard x:Key="SbXuong" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="pnlSkeleton" Storyboard.TargetProperty="Opacity"
                             From="0.45" To="1" Duration="0:0:0.8"/>
        </Storyboard>

        <Style x:Key="Xoay" TargetType="Path" BasedOn="{StaticResource IconNet}">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        </Style>

        <!-- Khung xương (skeleton) thay bảng trống khi đang tải: các thanh mờ nhấp nháy nhẹ -->
        <Style x:Key="Xuong" TargetType="Border">
            <Setter Property="Height" Value="12"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#1B2536"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
        </Style>
        <Style x:Key="KhungXuong" TargetType="ItemsControl">
            <Setter Property="Background" Value="#111827"/>
        </Style>

        <!-- Ô số liệu ở chân trang -->
        <Style x:Key="KpiO" TargetType="Border">
            <Setter Property="Background" Value="#0B1220"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="BorderBrush" Value="#172033"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="KpiNhan" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="KpiGiaTri" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>
        <Style x:Key="KpiDonVi" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="5,0,0,3"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Vạch thương hiệu: cùng dải màu với màn đăng nhập -->
        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#22D3EE" Offset="0"/>
                    <GradientStop Color="#2563EB" Offset="0.5"/>
                    <GradientStop Color="#16A34A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <DockPanel Grid.Row="1" Margin="16,14,16,14">

            <!-- ===== HEADER ===== -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Dấu hiệu phần mềm + tên -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="11">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0EA5B7" Offset="0"/>
                                    <GradientStop Color="#155E9C" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Path Style="{StaticResource IconNet}" Data="{StaticResource IcHoaDon}"
                                  Stroke="White" StrokeThickness="1.8" Width="20" Height="20" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Quản lý hóa đơn điện tử" FontSize="15" FontWeight="Bold" Foreground="#F1F5F9"/>
                            <TextBlock Text="Đồng bộ Tổng cục Thuế · Xuất Excel, PDF, XML gốc" FontSize="11"
                                       Foreground="#64748B" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Doanh nghiệp đang làm việc -->
                    <Button Grid.Column="1" x:Name="btnChonDN" HorizontalAlignment="Left" Margin="28,0,0,0"
                            Background="#1F2937" Content="Chưa chọn doanh nghiệp" ui:Ic.Glyph="{StaticResource IcCongTy}"
                            ToolTip="Chọn hoặc quản lý doanh nghiệp" Click="btnChonDN_Click"/>

                    <!-- Chip trạng thái: chấm màu + chữ, đổi theo việc đang làm -->
                    <Border Grid.Column="2" Background="#0B1220" BorderBrush="#172033" BorderThickness="1"
                            CornerRadius="18" Padding="12,0" Height="34" Margin="0,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="dotTrangThaiApp" Width="8" Height="8" Fill="#22C55E" VerticalAlignment="Center"/>
                            <TextBlock x:Name="lblTrangThaiApp" Text="Sẵn sàng" Foreground="#94A3B8" FontSize="12"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="3" x:Name="btnCaiDat" Style="{StaticResource NutPhu}"
                            Content="Cài đặt" ui:Ic.Glyph="{StaticResource IcCaiDat}" Click="btnCaiDat_Click"/>
                </Grid>
            </Border>

            <!-- ===== DẢI NHẮC KHÓA API (tự ẩn khi mọi thứ ổn) ===== -->
            <Border x:Name="brdNhacKhoa" DockPanel.Dock="Top" CornerRadius="12" Padding="16,12"
                    Margin="0,0,0,12" Background="#1C1917" BorderBrush="#B45309" BorderThickness="1"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="icoNhac" Grid.Column="0" Style="{StaticResource IconNet}"
                          Data="{StaticResource IcChiaKhoa}" Stroke="#FBBF24" Width="22" Height="22"
                          VerticalAlignment="Center" Margin="2,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="lblNhacTieuDe" Foreground="#FBBF24" FontWeight="Bold"
                                   FontSize="14" TextWrapping="Wrap"/>
                        <TextBlock x:Name="lblNhacNoiDung" Foreground="#94A3B8" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                        <TextBlock x:Name="lblNhacLienHe" Foreground="#22D3EE" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="btnNhacHanhDong" Background="#B45309"
                                Content="Nhập khóa" Click="btnNhacHanhDong_Click"/>
                        <Button x:Name="btnNhacDong" Background="#334155"
                                Width="42" Content="" ui:Ic.Glyph="{StaticResource IcDong}" Margin="8,0,0,0" Click="btnNhacDong_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== THANH LỌC + HÀNH ĐỘNG ===== -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,14,16,12">
                <StackPanel>
                    <!-- Hàng 1: bộ lọc -->
                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,20,8" VerticalAlignment="Bottom">
                            <TextBlock Text="LOẠI HÓA ĐƠN" Style="{StaticResource Lbl}"/>
                            <Border Background="#0B1220" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="btnMuaVao" Content="Mua vào (đầu vào)" Style="{StaticResource NutPhan}"
                                            Background="#16A34A" Foreground="White" Click="btnLoaiHD_Click"/>
                                    <Button x:Name="btnBanRa" Content="Bán ra (đầu ra)" Style="{StaticResource NutPhan}"
                                            Margin="3,0,0,0" Click="btnLoaiHD_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="0,0,14,8" VerticalAlignment="Bottom">
                            <TextBlock Text="KỲ KẾ TOÁN" Style="{StaticResource Lbl}"/>
                            <ComboBox x:Name="cboKy" Width="150" SelectedIndex="0"
                                      SelectionChanged="cboKy_SelectionChanged">
                                <ComboBoxItem>Theo Ngày</ComboBoxItem>
                                <ComboBoxItem>Theo Tháng</ComboBoxItem>
                                <ComboBoxItem>Theo Quý</ComboBoxItem>
                                <ComboBoxItem>Theo Năm</ComboBoxItem>
                                <ComboBoxItem>Tùy Chọn</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Margin="0,0,10,8" VerticalAlignment="Bottom">
                            <TextBlock Text="TỪ NGÀY" Style="{StaticResource Lbl}"/>
                            <DatePicker x:Name="dpTuNgay" Width="140"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,14,8" VerticalAlignment="Bottom">
                            <TextBlock Text="ĐẾN NGÀY" Style="{StaticResource Lbl}"/>
                            <DatePicker x:Name="dpDenNgay" Width="140"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,14,8" VerticalAlignment="Bottom">
                            <TextBlock Text="TRẠNG THÁI" Style="{StaticResource Lbl}"/>
                            <ComboBox x:Name="cboTrangThai" Width="160" SelectedIndex="0"
                                      SelectionChanged="cboTrangThai_SelectionChanged">
                                <ComboBoxItem>Tất cả</ComboBoxItem>
                                <ComboBoxItem>Hóa đơn mới</ComboBoxItem>
                                <ComboBoxItem>Hóa đơn thay thế</ComboBoxItem>
                                <ComboBoxItem>Hóa đơn điều chỉnh</ComboBoxItem>
                                <ComboBoxItem>Hóa đơn hủy</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,8" VerticalAlignment="Bottom">
                            <TextBlock Text="LOẠI CHỨNG TỪ" Style="{StaticResource Lbl}"/>
                            <ComboBox x:Name="cboLoaiCT" Width="160" SelectedIndex="0"
                                      SelectionChanged="cboLoaiCT_SelectionChanged">
                                <ComboBoxItem>Tất cả</ComboBoxItem>
                                <ComboBoxItem>Hóa đơn điện tử</ComboBoxItem>
                                <ComboBoxItem>HĐ máy tính tiền</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </WrapPanel>

                    <!-- Hàng 2: tìm kiếm bên trái, hành động bên phải (nút chính xanh ở ngoài cùng) -->
                    <DockPanel Margin="0,4,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <!-- Dùng API tra cứu HÀNG LOẠT (1 request cho cả danh sách, gộp trùng MST,
                                 cache 12h phía dịch vụ) nên không gây quá tải. -->
                            <Button x:Name="btnRuiRo" Content="Kiểm tra NCC" ui:Ic.Glyph="{StaticResource IcBaoVe}"
                                    Background="#9F1239" Click="btnRuiRo_Click"/>
                            <Button x:Name="btnThongKe" Content="Thống kê" ui:Ic.Glyph="{StaticResource IcThongKe}"
                                    Background="#6D28D9" Margin="10,0,0,0" Click="btnThongKe_Click"/>
                            <Button x:Name="btnDongBo" Content="Đồng bộ Tổng cục Thuế" ui:Ic.Glyph="{StaticResource IcDongBo}"
                                    Style="{StaticResource BtnGreen}" MinWidth="210" Margin="10,0,0,0" Click="btnDongBo_Click"/>
                        </StackPanel>

                        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="0,0,16,0">
                            <TextBlock Text="TÌM TRONG DANH SÁCH ĐANG XEM" Style="{StaticResource Lbl}"/>
                            <Grid Width="360">
                                <TextBox x:Name="txtTimKiem" Height="38" Padding="36,0,34,0"
                                         TextChanged="txtTimKiem_TextChanged"/>
                                <Path Style="{StaticResource IconNet}" Data="{StaticResource IcTim}" Width="15" Height="15"
                                      HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"/>
                                <TextBlock Text="MST, số hóa đơn hoặc tên đối tác" Foreground="#3E4B66" FontSize="12"
                                           Margin="36,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=txtTimKiem}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button x:Name="btnXoaTim" Width="28" Height="28" HorizontalAlignment="Right"
                                        Margin="0,0,5,0" Background="Transparent" Padding="0"
                                        ui:Ic.Glyph="{StaticResource IcXoaO}" ui:Ic.Size="15"
                                        ToolTip="Xóa từ khóa" Click="btnXoaTim_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Nut}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=txtTimKiem}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ===== CHÂN TRANG: 4 ô số liệu + phiên bản ===== -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource KpiO}">
                        <StackPanel>
                            <TextBlock Text="CHƯA THUẾ" Style="{StaticResource KpiNhan}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="lblChuaThue" Text="0" Style="{StaticResource KpiGiaTri}"/>
                                <TextBlock Text="VNĐ" Style="{StaticResource KpiDonVi}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource KpiO}">
                        <StackPanel>
                            <TextBlock Text="THUẾ GTGT" Style="{StaticResource KpiNhan}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="lblThue" Text="0" Style="{StaticResource KpiGiaTri}" Foreground="#67E8F9"/>
                                <TextBlock Text="VNĐ" Style="{StaticResource KpiDonVi}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource KpiO}">
                        <StackPanel>
                            <TextBlock Text="TỔNG THANH TOÁN" Style="{StaticResource KpiNhan}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="lblTong" Text="0" Style="{StaticResource KpiGiaTri}" Foreground="#4ADE80"/>
                                <TextBlock Text="VNĐ" Style="{StaticResource KpiDonVi}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource KpiO}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="SỐ LƯỢNG HÓA ĐƠN" Style="{StaticResource KpiNhan}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="lblSoLuong" Text="0/0" Style="{StaticResource KpiGiaTri}"/>
                                <TextBlock x:Name="lblSoLuongPhu" Text="đang xem / đã tải" Style="{StaticResource KpiDonVi}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Column="4" x:Name="lblPhienBan" Text="" Foreground="#3C4658" FontSize="10.5"
                               VerticalAlignment="Bottom" Margin="14,0,4,2"/>
                </Grid>
            </Border>

            <!-- ===== BẢNG HÓA ĐƠN (giữa, chiếm hết) ===== -->
            <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                <DockPanel>
                    <!-- Dải tiêu đề bảng: tên + số dòng + mô tả lần đồng bộ -->
                    <Grid DockPanel.Dock="Top" Margin="16,11,16,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Style="{StaticResource IconNet}" Data="{StaticResource IcDanhSach}"
                                  Stroke="#22D3EE" Width="16" Height="16"/>
                            <TextBlock Text="Danh sách hóa đơn" Foreground="#E2E8F0" FontWeight="SemiBold"
                                       FontSize="13.5" Margin="9,0,0,0" VerticalAlignment="Center"/>
                            <Border Background="#1E3A5F" CornerRadius="9" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="lblDemBang" Text="0" Foreground="#22D3EE" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="lblBangPhu" Text="Chưa đồng bộ" Foreground="#64748B" FontSize="11.5"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Vạch tải: chạy khi đang xử lý, thấy được cả khi hộp tiến trình che mờ -->
                    <Grid DockPanel.Dock="Top" Height="3" Background="#0F172A">
                        <Rectangle x:Name="rectTaiLine" Visibility="Collapsed">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <LinearGradientBrush.RelativeTransform>
                                        <TranslateTransform X="-1"/>
                                    </LinearGradientBrush.RelativeTransform>
                                    <GradientStop Color="#0022D3EE" Offset="0"/>
                                    <GradientStop Color="#FF22D3EE" Offset="0.45"/>
                                    <GradientStop Color="#FF16A34A" Offset="0.55"/>
                                    <GradientStop Color="#0016A34A" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>

                    <Grid>
                        <DataGrid x:Name="grdHoaDon" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Extended" SelectionUnit="FullRow"
                                  Background="Transparent" Foreground="#E2E8F0" BorderThickness="0"
                                  RowBackground="Transparent" AlternatingRowBackground="#0E1626"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#182238"
                                  HeadersVisibility="Column" FontSize="12.5" RowHeight="36" ColumnHeaderHeight="40"
                                  CanUserResizeRows="False" CanUserAddRows="False"
                                  ColumnHeaderStyle="{StaticResource DauCot}" CellStyle="{StaticResource ODuLieu}">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridRow">
                                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="Row_RightClick"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#162036"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#1C3556"/>
                                            <Setter Property="Foreground" Value="#F8FAFC"/>
                                        </Trigger>
                                        <!-- Nhà cung cấp bất thường: cả dòng đỏ, để trên dưới đều bắt mắt -->
                                        <DataTrigger Binding="{Binding NccRuiRo}" Value="True">
                                            <Setter Property="Background" Value="#4A1D24"/>
                                            <Setter Property="Foreground" Value="#FECACA"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding NccRuiRo}" Value="True"/>
                                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="#7F1D1D"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Xem hóa đơn" ui:Ic.Glyph="{StaticResource IcXem}" Click="mnuXem_Click"/>
                                    <MenuItem Header="Tải XML gốc" ui:Ic.Glyph="{StaticResource IcTai}" Click="mnuTaiXml_Click"/>
                                    <MenuItem Header="Lưu PDF 1 tờ (mở xem rồi Ctrl+P)" ui:Ic.Glyph="{StaticResource IcPdf}" Click="mnuTaiPdf_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Xuất PDF (dòng đã chọn)" ui:Ic.Glyph="{StaticResource IcPdf}" Click="mnuPdfChon_Click"/>
                                    <MenuItem Header="Xuất PDF (tất cả)" ui:Ic.Glyph="{StaticResource IcPdf}" Click="mnuPdf_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Xuất XML gốc (dòng đã chọn)" ui:Ic.Glyph="{StaticResource IcXml}" Click="mnuXmlChon_Click"/>
                                    <MenuItem Header="Xuất XML gốc (tất cả)" ui:Ic.Glyph="{StaticResource IcXml}" Click="mnuXml_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Xuất Excel (dòng đã chọn)" ui:Ic.Glyph="{StaticResource IcThongKe}" Click="mnuExcelChon_Click"/>
                                    <MenuItem Header="Xuất Excel (tất cả)" ui:Ic.Glyph="{StaticResource IcThongKe}" Click="mnuExcel_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Xuất bảng kê" ui:Ic.Glyph="{StaticResource IcBangKe}">
                                        <MenuItem Header="Khai thuế GTGT (theo hóa đơn) — nhanh, chuẩn TCT" Click="mnuBangKeKhaiThue_Click"/>
                                        <MenuItem Header="Chi tiết theo dòng hàng (mẫu MISA)" Click="mnuBangKe_Click"/>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="Cài đặt" ui:Ic.Glyph="{StaticResource IcCaiDat}" Click="mnuCaiDat_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <!-- Trạng thái XML: pill xanh lá -->
                                <DataGridTemplateColumn Header="Trạng thái XML" Width="116" SortMemberPath="TrangThaiXml">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Pill}" Background="#0F2A1F">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" Fill="#4ADE80" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding TrangThaiXml}" Style="{StaticResource PillChu}" Foreground="#4ADE80"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Ký hiệu" Binding="{Binding KyHieu}" Width="78" ElementStyle="{StaticResource CellCenter}"/>
                                <!-- Loại HĐ: pill xanh ngọc (điện tử) / hổ phách (máy tính tiền) -->
                                <DataGridTemplateColumn Header="Loại HĐ" Width="110" SortMemberPath="LoaiHD">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="pill" Style="{StaticResource Pill}" Background="#0F2A3A">
                                                <TextBlock x:Name="chu" Text="{Binding LoaiHD}" Style="{StaticResource PillChu}" Foreground="#67E8F9"/>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding LoaiHD}" Value="Máy tính tiền">
                                                    <Setter TargetName="pill" Property="Background" Value="#3B2A12"/>
                                                    <Setter TargetName="chu" Property="Foreground" Value="#FBBF24"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Số HĐ" Binding="{Binding SoHoaDon}" Width="82" ElementStyle="{StaticResource CellCenter}"/>
                                <DataGridTextColumn Header="Ngày lập" Binding="{Binding NgayLap}" Width="94" ElementStyle="{StaticResource CellCenter}"/>
                                <DataGridTextColumn Header="Người bán" Binding="{Binding NguoiBan}" Width="*" ElementStyle="{StaticResource CellLeft}"/>
                                <DataGridTextColumn Header="Người mua" Binding="{Binding NguoiMua}" Width="*" ElementStyle="{StaticResource CellLeft}"/>
                                <DataGridTextColumn Header="Chưa thuế" Binding="{Binding TongChuaThue}" Width="112" ElementStyle="{StaticResource CellRight}"/>
                                <DataGridTextColumn Header="Thuế" Binding="{Binding TongThue}" Width="92" ElementStyle="{StaticResource CellRight}"/>
                                <DataGridTextColumn Header="Thanh toán" Binding="{Binding TongThanhToan}" Width="122">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CellRight}">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <!-- Trạng thái: màu theo nghĩa (mới = xanh, thay thế/điều chỉnh = hổ phách, hủy = đỏ) -->
                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="146">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CellCenter}">
                                            <Setter Property="FontSize" Value="11.5"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TrangThai}" Value="Hóa đơn mới">
                                                    <Setter Property="Foreground" Value="#4ADE80"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TrangThai}" Value="Hóa đơn thay thế">
                                                    <Setter Property="Foreground" Value="#FBBF24"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TrangThai}" Value="Hóa đơn điều chỉnh">
                                                    <Setter Property="Foreground" Value="#FBBF24"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TrangThai}" Value="Hóa đơn bị thay thế">
                                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TrangThai}" Value="Hóa đơn bị điều chỉnh">
                                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TrangThai}" Value="Hóa đơn hủy">
                                                    <Setter Property="Foreground" Value="#F87171"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Tình trạng NCC" Binding="{Binding TinhTrangNcc}" Width="160" ElementStyle="{StaticResource CellLeft}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Khung xương: hiện lúc đang đồng bộ, che chỗ bảng để không thấy màn trống -->
                        <ItemsControl x:Name="pnlSkeleton" Style="{StaticResource KhungXuong}" Visibility="Collapsed"
                                      IsHitTestVisible="False" Margin="0,40,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="36" Margin="16,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="74"/>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition Width="114"/>
                                            <ColumnDefinition Width="134"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource Xuong}" Width="70" HorizontalAlignment="Left" CornerRadius="9" Height="18"/>
                                        <Border Grid.Column="1" Style="{StaticResource Xuong}"/>
                                        <Border Grid.Column="2" Style="{StaticResource Xuong}" Width="64" HorizontalAlignment="Left" CornerRadius="9" Height="18"/>
                                        <Border Grid.Column="3" Style="{StaticResource Xuong}"/>
                                        <Border Grid.Column="4" Style="{StaticResource Xuong}"/>
                                        <Border Grid.Column="5" Style="{StaticResource Xuong}"/>
                                        <Border Grid.Column="6" Style="{StaticResource Xuong}" Margin="0,0,60,0"/>
                                        <Border Grid.Column="7" Style="{StaticResource Xuong}"/>
                                        <Border Grid.Column="8" Style="{StaticResource Xuong}"/>
                                        <Border Grid.Column="9" Style="{StaticResource Xuong}"/>
                                        <Border Grid.Column="10" Style="{StaticResource Xuong}" Margin="0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Bảng trống mà không nói gì thì người dùng không biết đang thiếu bước nào -->
                        <StackPanel x:Name="pnlTrongHD" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="84" Height="84" CornerRadius="42" Background="#0F172A" HorizontalAlignment="Center">
                                <Path x:Name="icoTrongHD" Style="{StaticResource IconNet}" Data="{StaticResource IcTimHoaDon}"
                                      Stroke="#3B4B66" Width="36" Height="36" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="lblTrongHD" Text="Chưa có hóa đơn nào" Foreground="#94A3B8" FontSize="15"
                                       FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                            <TextBlock x:Name="lblTrongHDPhu" Text="Chọn doanh nghiệp rồi bấm “Đồng bộ Tổng cục Thuế”"
                                       Foreground="#64748B" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"
                                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360"/>
                            <Button x:Name="btnTrongHanhDong" Content="Chọn doanh nghiệp" Style="{StaticResource NutPhu}"
                                    ui:Ic.Glyph="{StaticResource IcCongTy}" HorizontalAlignment="Center" Margin="0,16,0,0"
                                    Click="btnTrongHanhDong_Click"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </DockPanel>

        <!-- ===== HỘP TIẾN TRÌNH (phủ toàn màn hình khi tải / xuất) ===== -->
        <Grid x:Name="overlayProgress" Grid.RowSpan="2" Background="#A60B0F1A" Visibility="Collapsed">
            <Border Background="#111827" BorderBrush="#243352" BorderThickness="1" CornerRadius="16"
                    Padding="28,26" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="6" Opacity="0.55"/>
                </Border.Effect>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="46" Height="46" CornerRadius="23" Background="#0F2A3A" Margin="0,0,16,0" VerticalAlignment="Top">
                            <Path x:Name="icoXoay" Style="{StaticResource Xoay}" Data="{StaticResource IcXoay}"
                                  Stroke="#22D3EE" StrokeThickness="2.2" Width="22" Height="22" HorizontalAlignment="Center">
                                <!-- Transform đặt ngay trên phần tử để không bị đóng băng, storyboard mới xoay được -->
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="lblProgressTieuDe" Text="Đang xử lý" FontSize="16" FontWeight="Bold" Foreground="#F1F5F9"/>
                            <TextBlock x:Name="txtProgress" Text="Đang xử lý..." Foreground="#94A3B8" FontSize="12.5"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,20,0,8">
                        <TextBlock x:Name="lblProgressPhanTram" Text="" Foreground="#22D3EE" FontSize="12"
                                   FontWeight="SemiBold" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="lblProgressThoiGian" Text="0:00" Foreground="#64748B" FontSize="12"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <ProgressBar x:Name="barProgress" Style="{StaticResource ThanhTienTrinh}" Minimum="0" Maximum="100" Value="0"/>

                    <Grid Margin="0,20,0,0">
                        <TextBlock Text="Có thể làm việc khác trên máy, chỉ đừng tắt phần mềm." Foreground="#475569"
                                   FontSize="11" VerticalAlignment="Center"/>
                        <Button x:Name="btnCancel" Content="Hủy" ui:Ic.Glyph="{StaticResource IcDong}" Style="{StaticResource NutPhu}"
                                Width="110" Height="36" HorizontalAlignment="Right" Click="btnCancel_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== THÔNG BÁO NHANH (toast) góc dưới phải, tự tắt ===== -->
        <Border x:Name="brdToast" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,26,26" Visibility="Collapsed" Opacity="0" MaxWidth="440"
                Background="#111827" BorderBrush="#243352" BorderThickness="1" CornerRadius="12" Padding="14,12">
            <Border.RenderTransform>
                <TranslateTransform x:Name="trToast" Y="12"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="4" Opacity="0.5"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="brdToastIcon" Width="34" Height="34" CornerRadius="17" Background="#0F2A1F" Margin="0,0,12,0" VerticalAlignment="Top">
                    <Path x:Name="icoToast" Style="{StaticResource IconNet}" Data="{StaticResource IcTick}"
                          Stroke="#4ADE80" Width="17" Height="17" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="lblToastTieuDe" Text="Xong" Foreground="#F1F5F9" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock x:Name="lblToastNoiDung" Text="" Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" x:Name="btnToastDong" Width="30" Height="30" Background="Transparent" Padding="0"
                        Margin="8,0,0,0" VerticalAlignment="Top" ui:Ic.Glyph="{StaticResource IcDong}" ui:Ic.Size="13"
                        Click="btnToastDong_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
