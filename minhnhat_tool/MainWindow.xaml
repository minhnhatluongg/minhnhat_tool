<Window x:Class="minhnhat_tool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:minhnhat_tool.Ui"
        Title="Phần mềm quản lý hóa đơn" Height="720" Width="1200"
        Icon="app.ico" Language="vi-VN"
        WindowStartupLocation="CenterScreen" Background="#0b0f1a">

    <!-- ===== STYLE dùng chung (cho nút bo góc, dark) ===== -->
    <Window.Resources>
        <Style x:Key="BtnGreen" TargetType="Button" BasedOn="{StaticResource Nut}">
            <Setter Property="Background" Value="#16a34a"/>
        </Style>
        <Style x:Key="BtnOrange" TargetType="Button" BasedOn="{StaticResource Nut}">
            <Setter Property="Background" Value="#ea8a1e"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- ===== Dark ComboBox ===== -->


        <!-- ===== Dark DatePicker ===== -->


        <!-- Canh lề nội dung ô bảng -->
        <Style x:Key="CellCenter" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CellRight" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </Window.Resources>

    <Grid>
    <DockPanel Margin="14">
        <!-- ===== HEADER ===== -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="btnChonDN"
                        Background="#1f2937" Content="Chưa chọn doanh nghiệp" ui:Ic.Glyph="{StaticResource IcCongTy}"
                        Click="btnChonDN_Click"/>

                <TextBlock Grid.Column="1" Text="PHẦN MỀM QUẢN LÝ HÓA ĐƠN"
                           Foreground="#22d3ee" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"/>

                <Button Grid.Column="2" x:Name="btnCaiDat"
                        Background="#1f2937" Content="Cài đặt" ui:Ic.Glyph="{StaticResource IcCaiDat}" Click="btnCaiDat_Click"/>
            </Grid>
        </Border>

        <!-- ===== DẢI NHẮC KHÓA API (tự ẩn khi mọi thứ ổn) ===== -->
        <Border x:Name="brdNhacKhoa" DockPanel.Dock="Top" CornerRadius="12" Padding="16,12"
                Margin="0,0,0,12" Background="#1c1917" BorderBrush="#b45309" BorderThickness="1"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Path x:Name="icoNhac" Grid.Column="0" Style="{StaticResource IconNet}"
                      Data="{StaticResource IcChiaKhoa}" Stroke="#FBBF24" Width="22" Height="22"
                      VerticalAlignment="Center" Margin="2,0,14,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="lblNhacTieuDe" Foreground="#fbbf24" FontWeight="Bold"
                               FontSize="14" TextWrapping="Wrap"/>
                    <TextBlock x:Name="lblNhacNoiDung" Foreground="#94a3b8" FontSize="12"
                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                    <TextBlock x:Name="lblNhacLienHe" Foreground="#22d3ee" FontSize="12"
                               TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnNhacHanhDong" Background="#b45309"
                            Content="Nhập khóa" Click="btnNhacHanhDong_Click"/>
                    <Button x:Name="btnNhacDong" Background="#334155"
                            Width="42" Content="" ui:Ic.Glyph="{StaticResource IcDong}" Margin="8,0,0,0" Click="btnNhacDong_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== TOOLBAR (bộ lọc + hành động) ===== -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
            <WrapPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,24,0" VerticalAlignment="Bottom">
                    <TextBlock Text="LOẠI HÓA ĐƠN" Style="{StaticResource Lbl}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="btnMuaVao" Content="Mua vào (đầu vào)"
                                Background="#16a34a" Width="140" Click="btnLoaiHD_Click"/>
                        <Button x:Name="btnBanRa" Content="Bán ra (đầu ra)"
                                Background="#1f2937" Width="130" Margin="8,0,0,0" Click="btnLoaiHD_Click"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Margin="0,0,24,0" VerticalAlignment="Bottom">
                    <TextBlock Text="KỲ KẾ TOÁN" Style="{StaticResource Lbl}"/>
                    <ComboBox x:Name="cboKy" Width="150" SelectedIndex="0"
                              SelectionChanged="cboKy_SelectionChanged">
                        <ComboBoxItem>Theo Ngày</ComboBoxItem>
                        <ComboBoxItem>Theo Tháng</ComboBoxItem>
                        <ComboBoxItem>Theo Quý</ComboBoxItem>
                        <ComboBoxItem>Theo Năm</ComboBoxItem>
                        <ComboBoxItem>Tùy Chọn</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <StackPanel Margin="0,0,12,0" VerticalAlignment="Bottom">
                    <TextBlock Text="TỪ NGÀY" Style="{StaticResource Lbl}"/>
                    <DatePicker x:Name="dpTuNgay" Width="140"/>
                </StackPanel>

                <StackPanel Margin="0,0,24,0" VerticalAlignment="Bottom">
                    <TextBlock Text="ĐẾN NGÀY" Style="{StaticResource Lbl}"/>
                    <DatePicker x:Name="dpDenNgay" Width="140"/>
                </StackPanel>

                <StackPanel Margin="0,0,12,0" VerticalAlignment="Bottom">
                    <TextBlock Text="TRẠNG THÁI" Style="{StaticResource Lbl}"/>
                    <ComboBox x:Name="cboTrangThai" Width="150" SelectedIndex="0"
                              SelectionChanged="cboTrangThai_SelectionChanged">
                        <ComboBoxItem>Tất cả</ComboBoxItem>
                        <ComboBoxItem>Hóa đơn mới</ComboBoxItem>
                        <ComboBoxItem>Hóa đơn thay thế</ComboBoxItem>
                        <ComboBoxItem>Hóa đơn điều chỉnh</ComboBoxItem>
                        <ComboBoxItem>Hóa đơn hủy</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <StackPanel Margin="0,0,12,0" VerticalAlignment="Bottom">
                    <TextBlock Text="LOẠI CHỨNG TỪ" Style="{StaticResource Lbl}"/>
                    <ComboBox x:Name="cboLoaiCT" Width="160" SelectedIndex="0"
                              SelectionChanged="cboLoaiCT_SelectionChanged">
                        <ComboBoxItem>Tất cả</ComboBoxItem>
                        <ComboBoxItem>Hóa đơn điện tử</ComboBoxItem>
                        <ComboBoxItem>HĐ máy tính tiền</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <StackPanel Margin="0,0,12,0" VerticalAlignment="Bottom">
                    <TextBlock Text="TÌM TRONG DANH SÁCH ĐANG XEM" Style="{StaticResource Lbl}"/>
                    <Grid Width="300">
                        <TextBox x:Name="txtTimKiem" Height="40" Padding="36,0,34,0"
                                 TextChanged="txtTimKiem_TextChanged"/>
                        <Path Style="{StaticResource IconNet}" Data="{StaticResource IcTim}" Width="15" Height="15"
                              HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"/>
                        <TextBlock Text="MST, số hóa đơn hoặc tên" Foreground="#3E4B66" FontSize="12"
                                   Margin="36,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=txtTimKiem}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button x:Name="btnXoaTim" Width="28" Height="28" HorizontalAlignment="Right"
                                Margin="0,0,5,0" Background="Transparent" Padding="0"
                                ui:Ic.Glyph="{StaticResource IcXoaO}" ui:Ic.Size="15"
                                ToolTip="Xóa từ khóa" Click="btnXoaTim_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Nut}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=txtTimKiem}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal">
                    <Button x:Name="btnDongBo" Content="Đồng bộ Tổng cục Thuế" ui:Ic.Glyph="{StaticResource IcDongBo}" Style="{StaticResource BtnGreen}"
                            Width="220" Click="btnDongBo_Click"/>
                    <Button x:Name="btnThongKe" Content="Thống kê" ui:Ic.Glyph="{StaticResource IcThongKe}"
                            Background="#7c3aed" Width="130" Margin="10,0,0,0" Click="btnThongKe_Click"/>
                    <!-- Bật lại: nay dùng API tra cứu HÀNG LOẠT (1 request cho cả danh sách,
                         gộp trùng MST + cache 12h phía dịch vụ) nên không còn gây quá tải. -->
                    <Button x:Name="btnRuiRo" Content="Kiểm tra NCC" ui:Ic.Glyph="{StaticResource IcBaoVe}"
                            Background="#b91c1c" Width="160" Margin="10,0,0,0" Click="btnRuiRo_Click"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- ===== STATUS BAR (đáy) ===== -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="lblChuaThue" Text="Chưa thuế: 0 VNĐ" Foreground="#22c55e" Margin="0,0,30,0"/>
                <TextBlock x:Name="lblThue" Text="Thuế: 0 VNĐ" Foreground="#22c55e" Margin="0,0,30,0"/>
                <TextBlock x:Name="lblTong" Text="Tổng thanh toán: 0 VNĐ" Foreground="#22c55e" Margin="0,0,30,0"/>
                <TextBlock x:Name="lblSoLuong" Text="Số lượng XML: 0/0" Foreground="#94a3b8"/>
            </StackPanel>
        </Border>

        <!-- ===== BẢNG HÓA ĐƠN (giữa, chiếm hết) ===== -->
        <Border Style="{StaticResource Card}" Padding="0">
          <Grid>
            <DataGrid x:Name="grdHoaDon" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Extended" SelectionUnit="FullRow"
                      Background="Transparent" Foreground="#e2e8f0" BorderThickness="0"
                      RowBackground="#0f172a" AlternatingRowBackground="#131c31"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1e293b"
                      HeadersVisibility="Column" FontSize="12">
                <DataGrid.Resources>
                    <Style TargetType="DataGridRow">
                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="Row_RightClick"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NccRuiRo}" Value="True">
                                <Setter Property="Background" Value="#7f1d1d"/>
                                <Setter Property="Foreground" Value="#fecaca"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Xem hóa đơn" ui:Ic.Glyph="{StaticResource IcXem}" Click="mnuXem_Click"/>
                        <MenuItem Header="Tải XML gốc" ui:Ic.Glyph="{StaticResource IcTai}" Click="mnuTaiXml_Click"/>
                        <MenuItem Header="Lưu PDF 1 tờ (mở xem rồi Ctrl+P)" ui:Ic.Glyph="{StaticResource IcPdf}" Click="mnuTaiPdf_Click"/>
                        <Separator/>
                        <MenuItem Header="Xuất PDF (dòng đã chọn)" ui:Ic.Glyph="{StaticResource IcPdf}" Click="mnuPdfChon_Click"/>
                        <MenuItem Header="Xuất PDF (tất cả)" ui:Ic.Glyph="{StaticResource IcPdf}" Click="mnuPdf_Click"/>
                        <Separator/>
                        <MenuItem Header="Xuất XML gốc (dòng đã chọn)" ui:Ic.Glyph="{StaticResource IcXml}" Click="mnuXmlChon_Click"/>
                        <MenuItem Header="Xuất XML gốc (tất cả)" ui:Ic.Glyph="{StaticResource IcXml}" Click="mnuXml_Click"/>
                        <Separator/>
                        <MenuItem Header="Xuất Excel (dòng đã chọn)" ui:Ic.Glyph="{StaticResource IcThongKe}" Click="mnuExcelChon_Click"/>
                        <MenuItem Header="Xuất Excel (tất cả)" ui:Ic.Glyph="{StaticResource IcThongKe}" Click="mnuExcel_Click"/>
                        <Separator/>
                        <MenuItem Header="Xuất bảng kê" ui:Ic.Glyph="{StaticResource IcBangKe}">
                            <MenuItem Header="Khai thuế GTGT (theo hóa đơn) — nhanh, chuẩn TCT" Click="mnuBangKeKhaiThue_Click"/>
                            <MenuItem Header="Chi tiết theo dòng hàng (mẫu MISA)" Click="mnuBangKe_Click"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Cài đặt" ui:Ic.Glyph="{StaticResource IcCaiDat}" Click="mnuCaiDat_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#0f172a"/>
                        <Setter Property="Foreground" Value="#22c55e"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="12,12"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Trạng thái XML" Binding="{Binding TrangThaiXml}" Width="125" ElementStyle="{StaticResource CellCenter}"/>
                    <DataGridTextColumn Header="Ký hiệu"       Binding="{Binding KyHieu}"      Width="80"  ElementStyle="{StaticResource CellCenter}"/>
                    <DataGridTextColumn Header="Loại HĐ"       Binding="{Binding LoaiHD}"      Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CellCenter}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LoaiHD}" Value="Máy tính tiền">
                                        <Setter Property="Foreground" Value="#f59e0b"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Số HĐ"          Binding="{Binding SoHoaDon}"    Width="90"  ElementStyle="{StaticResource CellCenter}"/>
                    <DataGridTextColumn Header="Ngày lập"       Binding="{Binding NgayLap}"     Width="100" ElementStyle="{StaticResource CellCenter}"/>
                    <DataGridTextColumn Header="Người bán"      Binding="{Binding NguoiBan}"    Width="*"/>
                    <DataGridTextColumn Header="Người mua"      Binding="{Binding NguoiMua}"    Width="*"/>
                    <DataGridTextColumn Header="Chưa thuế"      Binding="{Binding TongChuaThue}" Width="120" ElementStyle="{StaticResource CellRight}"/>
                    <DataGridTextColumn Header="Thuế"           Binding="{Binding TongThue}"    Width="100" ElementStyle="{StaticResource CellRight}"/>
                    <DataGridTextColumn Header="Thanh toán"     Binding="{Binding TongThanhToan}" Width="130" ElementStyle="{StaticResource CellRight}"/>
                    <DataGridTextColumn Header="Trạng thái"     Binding="{Binding TrangThai}"   Width="120" ElementStyle="{StaticResource CellCenter}"/>
                    <DataGridTextColumn Header="Tình trạng NCC" Binding="{Binding TinhTrangNcc}" Width="180"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Bảng trống mà không nói gì thì người dùng không biết đang thiếu bước nào -->
            <StackPanel x:Name="pnlTrongHD" VerticalAlignment="Center" HorizontalAlignment="Center"
                        IsHitTestVisible="False">
                <Path x:Name="icoTrongHD" Style="{StaticResource IconNet}" Data="{StaticResource IcTimHoaDon}"
                      Stroke="#334155" Width="46" Height="46" HorizontalAlignment="Center"/>
                <TextBlock x:Name="lblTrongHD" Text="Chưa có hóa đơn nào" Foreground="#64748B" FontSize="14"
                           HorizontalAlignment="Center" Margin="0,14,0,0"/>
                <TextBlock x:Name="lblTrongHDPhu" Text="Chọn doanh nghiệp rồi bấm “Đồng bộ Tổng cục Thuế”"
                           Foreground="#475569" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320"/>
            </StackPanel>
          </Grid>
        </Border>
    </DockPanel>

        <!-- Overlay progress bar (hiện khi tải / xuất Excel) -->
        <Grid x:Name="overlayProgress" Background="#CC0b0f1a" Visibility="Collapsed">
            <Border Background="#16213e" CornerRadius="12" Padding="34" Width="470"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="txtProgress" Text="Đang xử lý..." Foreground="White"
                               FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,18"/>
                    <ProgressBar x:Name="barProgress" Height="20" Minimum="0" Maximum="100" Value="0"
                                 Foreground="#22c55e" Background="#0f172a" BorderThickness="0"/>
                    <Button x:Name="btnCancel" Content="Hủy" ui:Ic.Glyph="{StaticResource IcDong}"
                            Background="#b91c1c" Width="120" Height="36" Margin="0,18,0,0"
                            HorizontalAlignment="Center" Click="btnCancel_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
