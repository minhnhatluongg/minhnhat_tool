<Window x:Class="minhnhat_tool.Ui.LoiDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:minhnhat_tool.Ui"
        Title="Lỗi" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#0B0F1A">

    <!-- Hộp thoại lỗi dùng chung: câu ngắn cho người dùng ở trên; mã HTTP, JSON thô, stack trace
         gập lại trong "Chi tiết kỹ thuật" bên dưới. Thay cho MessageBox in nguyên phản hồi của TCT. -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Ô chi tiết: nhiều dòng, có thanh cuộn. Mẫu TextBox chung của app là 1 dòng và giấu thanh cuộn
             nên phải tự vẽ lại ở đây. -->
        <Style x:Key="OChiTiet" TargetType="TextBox">
            <Setter Property="Background" Value="#0B1220"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderBrush" Value="#2A3A57"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="MaxHeight" Value="220"/>
            <Setter Property="SelectionBrush" Value="#22D3EE"/>
            <Setter Property="CaretBrush" Value="#22D3EE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          Focusable="False" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút gập/mở chi tiết: trông như dòng chữ có mũi tên, không phải nút -->
        <Style x:Key="NutChiTiet" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#22D3EE"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel x:Name="pnl" Orientation="Horizontal" Background="Transparent">
                            <Path x:Name="mui" Style="{StaticResource IconNet}" Data="{StaticResource IcXuong}"
                                  Stroke="{TemplateBinding Foreground}" Width="13" Height="13"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="-90"/>
                                </Path.RenderTransform>
                            </Path>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="mui" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pnl" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,22,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- icon + tiêu đề + thông báo -->
            <RowDefinition Height="Auto"/>   <!-- nút gập/mở chi tiết -->
            <RowDefinition Height="Auto"/>   <!-- ô chi tiết -->
            <RowDefinition Height="Auto"/>   <!-- hàng nút -->
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Huy hiệu đỏ: nhìn là biết có lỗi trước khi đọc chữ -->
            <Border Width="44" Height="44" CornerRadius="22" Background="#3B1D24"
                    VerticalAlignment="Top" Margin="0,0,16,0">
                <Path Style="{StaticResource IconNet}" Data="{StaticResource IcCanhBao}"
                      Stroke="#F87171" Width="22" Height="22" HorizontalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1">
                <TextBlock x:Name="txtTieuDe" FontSize="16" FontWeight="Bold" Foreground="#F1F5F9"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="txtThongBao" Foreground="#CBD5E1" FontSize="13" TextWrapping="Wrap"
                           LineHeight="20" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>

        <ToggleButton x:Name="btnChiTiet" Grid.Row="1" Style="{StaticResource NutChiTiet}"
                      Content="Chi tiết kỹ thuật" Margin="60,14,0,0"/>

        <TextBox x:Name="txtChiTiet" Grid.Row="2" Style="{StaticResource OChiTiet}" Margin="60,8,0,0"
                 Visibility="{Binding IsChecked, ElementName=btnChiTiet, Converter={StaticResource BoolToVis}}"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="btnSaoChep" Content="Sao chép chi tiết" Style="{StaticResource NutNho}"
                    Height="36" Margin="0,0,10,0" Click="btnSaoChep_Click"/>
            <Button x:Name="btnDong" Content="Đóng" ui:Ic.Glyph="{StaticResource IcDong}"
                    Background="#1E3A5F" Width="110" IsDefault="True" IsCancel="True" Click="btnDong_Click"/>
        </StackPanel>
    </Grid>
</Window>
