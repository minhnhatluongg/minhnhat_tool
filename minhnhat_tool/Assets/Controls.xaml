<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:minhnhat_tool.Ui">

    <!-- ====================================================================
         GIAO DIỆN TỐI DÙNG CHUNG

         Windows vẽ CheckBox / RadioButton / TextBox / ComboBox theo tông SÁNG,
         thả lên nền tối là ra mấy ô trắng lạc lõng. Ở đây thay hẳn mẫu vẽ
         (ControlTemplate) cho tông tối.

         Cố ý dùng style KHÔNG ĐẶT TÊN (implicit): mọi control trong app tự đổi,
         không phải sửa từng chỗ và không thể quên chỗ nào.
         ==================================================================== -->

    <!-- ===== Bảng màu ===== -->
    <SolidColorBrush x:Key="NenApp"     Color="#0B0F1A"/>
    <SolidColorBrush x:Key="NenThe"     Color="#111827"/>
    <SolidColorBrush x:Key="NenO"       Color="#0B1220"/>
    <SolidColorBrush x:Key="Vien"       Color="#2A3A57"/>
    <SolidColorBrush x:Key="VienDam"    Color="#1E293B"/>
    <SolidColorBrush x:Key="Nhan"       Color="#22D3EE"/>
    <SolidColorBrush x:Key="ChuChinh"   Color="#E2E8F0"/>
    <SolidColorBrush x:Key="ChuPhu"     Color="#94A3B8"/>
    <SolidColorBrush x:Key="ChuMo"      Color="#64748B"/>
    <SolidColorBrush x:Key="Luc"        Color="#16A34A"/>

    <!-- ===== Icon ===== -->
    <!-- Icon Lucide vẽ bằng NÉT: phải Stroke, không Fill. -->
    <Style x:Key="IconNet" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Fill" Value="{x:Null}"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Stroke" Value="#94A3B8"/>
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ===== Nút ===== -->
    <!-- Icon lấy từ ui:Ic.Glyph; không gán thì phần icon thu về 0, nút vẫn như cũ. -->
    <Style x:Key="Nut" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#1F2937"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Path x:Name="ic" Style="{StaticResource IconNet}"
                                  Stroke="{TemplateBinding Foreground}"
                                  Data="{Binding Path=(ui:Ic.Glyph), RelativeSource={RelativeSource TemplatedParent}}"
                                  Width="{Binding Path=(ui:Ic.Size), RelativeSource={RelativeSource TemplatedParent}}"
                                  Height="{Binding Path=(ui:Ic.Size), RelativeSource={RelativeSource TemplatedParent}}"
                                  Margin="0,0,8,0"/>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Nút không có icon: bỏ hẳn chỗ trống, tránh lệch chữ -->
                        <DataTrigger Binding="{Binding Path=(ui:Ic.Glyph), RelativeSource={RelativeSource Self}}"
                                     Value="{x:Null}">
                            <Setter TargetName="ic" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.72"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NutNho" TargetType="Button" BasedOn="{StaticResource Nut}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Background" Value="#293548"/>
        <Setter Property="ui:Ic.Size" Value="14"/>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource Nut}"/>

    <!-- ===== Ô nhập ===== -->
    <!-- Mẫu gốc của Windows là ô vuông nền trắng; ở đây bo góc, nền lõm, viền sáng khi gõ. -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource NenO}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="CaretBrush" Value="#22D3EE"/>
        <Setter Property="SelectionBrush" Value="#22D3EE"/>
        <Setter Property="BorderBrush" Value="{StaticResource Vien}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="11,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#3B517A"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#22D3EE"/>
                            <Setter TargetName="bd" Property="Background" Value="#0E1626"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource NenO}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="CaretBrush" Value="#22D3EE"/>
        <Setter Property="BorderBrush" Value="{StaticResource Vien}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="11,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#22D3EE"/>
                            <Setter TargetName="bd" Property="Background" Value="#0E1626"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Ô đánh dấu ===== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource ChuChinh}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- Background trong suốt để bấm vào cả dòng chữ, không phải nhắm đúng ô vuông -->
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="o" Width="19" Height="19" CornerRadius="5"
                                Background="{StaticResource NenO}" BorderBrush="{StaticResource Vien}"
                                BorderThickness="1.5" VerticalAlignment="Center">
                            <Path x:Name="tick" Stretch="Uniform" Width="11" Height="11" Fill="{x:Null}"
                                  Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="{StaticResource IcTick}" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="o" Property="Background" Value="{StaticResource Luc}"/>
                            <Setter TargetName="o" Property="BorderBrush" Value="{StaticResource Luc}"/>
                            <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="o" Property="BorderBrush" Value="#22D3EE"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Nút chọn ===== -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource ChuChinh}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="19" Height="19" VerticalAlignment="Center">
                            <Ellipse x:Name="o" Fill="{StaticResource NenO}"
                                     Stroke="{StaticResource Vien}" StrokeThickness="1.5"/>
                            <Ellipse x:Name="cham" Width="9" Height="9" Fill="#22D3EE" Visibility="Collapsed"/>
                        </Grid>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="o" Property="Stroke" Value="#22D3EE"/>
                            <Setter TargetName="cham" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="o" Property="Stroke" Value="#22D3EE"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Hộp chọn ===== -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource ChuChinh}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#1E3A5F"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource ChuChinh}"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bd" Background="{StaticResource NenO}"
                                            BorderBrush="{StaticResource Vien}" BorderThickness="1"
                                            CornerRadius="8">
                                        <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Margin="0,0,11,0" Width="13" Height="13"
                                              Style="{StaticResource IconNet}" Data="{StaticResource IcXuong}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#3B517A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="12,0,30,0" VerticalAlignment="Center"
                                          IsHitTestVisible="False"/>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border Background="#111827" BorderBrush="{StaticResource Vien}"
                                    BorderThickness="1" CornerRadius="8" MaxHeight="260" Margin="0,4,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.6"/>
                                </Border.Effect>
                                <ScrollViewer>
                                    <StackPanel IsItemsHost="True"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Ô chọn ngày ===== -->
    <Style TargetType="DatePickerTextBox">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border x:Name="bd" Background="{StaticResource NenO}" BorderBrush="{StaticResource Vien}"
                            BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0"
                                               VerticalContentAlignment="Center" Margin="11,0,0,0"
                                               Background="Transparent" BorderThickness="0" Foreground="White"/>
                            <Button x:Name="PART_Button" Grid.Column="1" Width="34" Focusable="False"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent">
                                            <Path Style="{StaticResource IconNet}" Data="{StaticResource IcLich}"
                                                  Width="15" Height="15" HorizontalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Popup x:Name="PART_Popup" StaysOpen="False" AllowsTransparency="True"
                                   Placement="Bottom" PlacementTarget="{Binding ElementName=PART_TextBox}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#3B517A"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Thanh cuộn ===== -->
    <!-- Thanh cuộn mặc định của Windows sáng trưng, cắt ngang mảng tối rất chối. -->
    <Style x:Key="TayCuon" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="t" Background="#2C3E60" CornerRadius="4" Margin="2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="t" Property="Background" Value="#475569"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="9"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource TayCuon}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="9"/>
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource TayCuon}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Menu chuột phải ===== -->
    <Style TargetType="ContextMenu">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="#111827" BorderBrush="{StaticResource Vien}" BorderThickness="1"
                            CornerRadius="10" Padding="6">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="5" Opacity="0.65"/>
                        </Border.Effect>
                        <StackPanel IsItemsHost="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource ChuChinh}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="10,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path x:Name="ic" Grid.Column="0" Style="{StaticResource IconNet}"
                                  Width="15" Height="15" HorizontalAlignment="Left"
                                  Data="{Binding Path=(ui:Ic.Glyph), RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                            <Path x:Name="mt" Grid.Column="2" Style="{StaticResource IconNet}" Width="13" Height="13"
                                  Data="{StaticResource IcXuong}" Visibility="Collapsed" Margin="12,0,0,0"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Right"
                                   PopupAnimation="Fade">
                                <Border Background="#111827" BorderBrush="{StaticResource Vien}"
                                        BorderThickness="1" CornerRadius="10" Padding="6" Margin="4,0,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="5" Opacity="0.65"/>
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#1E3A5F"/>
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="mt" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{StaticResource VienDam}" Margin="8,5"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Thẻ (tab) ===== -->
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource ChuPhu}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="bd" Background="Transparent" BorderThickness="0,0,0,3"
                            BorderBrush="Transparent" Padding="16,10" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="ic" Style="{StaticResource IconNet}" Width="16" Height="16"
                                  Stroke="{TemplateBinding Foreground}" Margin="0,0,8,0"
                                  Data="{Binding Path=(ui:Ic.Glyph), RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Path=(ui:Ic.Glyph), RelativeSource={RelativeSource Self}}"
                                     Value="{x:Null}">
                            <Setter TargetName="ic" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#22D3EE"/>
                            <Setter TargetName="bd" Property="Background" Value="#111827"/>
                            <Setter Property="Foreground" Value="#22D3EE"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource ChuChinh}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Chú thích ===== -->
    <Style TargetType="ToolTip">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="#0B1220" BorderBrush="{StaticResource Vien}" BorderThickness="1"
                            CornerRadius="6" Padding="10,6">
                        <ContentPresenter TextBlock.Foreground="{StaticResource ChuChinh}"
                                          TextBlock.FontSize="12"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Nhãn dùng lại ===== -->
    <Style x:Key="TieuDeMuc" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Nhan}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="15"/>
    </Style>
    <Style x:Key="ChuNhan" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ChuPhu}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===== Dòng trong danh sách ===== -->
    <Style x:Key="MucDanhSach" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource ChuChinh}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="7" Padding="12,9" Margin="0,1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#16213A"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#1E3A5F"/>
                            <Setter Property="Foreground" Value="#22D3EE"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Mẫu gốc chỉ tô nền phần NỘI DUNG, dải chứa các thẻ vẫn trắng theo hệ thống -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource NenApp}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource VienDam}" BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" Panel.ZIndex="1" Margin="0"/>
                        </Border>
                        <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
