<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ====================================================================
         BỘ ICON + MÀU THƯƠNG HIỆU

         Icon lấy từ Lucide (https://lucide.dev) — giấy phép ISC, dùng thương mại
         tự do, không phải ghi công. Xem Assets/LICENSES.txt.
         Đây chính là bộ icon dashboard web đang dùng (lucide-react), nên app
         desktop và trang quản trị nhìn ra cùng một sản phẩm.

         Vì sao là Geometry chứ không phải file PNG/SVG: nét ở mọi mức DPI, đổi
         màu theo giao diện, và không cần thêm thư viện nào.

         Icon Lucide vẽ bằng NÉT (stroke) trên khung 24x24 — phải dùng
         Stroke + StrokeThickness, KHÔNG dùng Fill, nếu không sẽ ra một khối đặc.
         Dùng qua style IconNet ở dưới là đúng sẵn.
         ==================================================================== -->

    <!-- Màu lấy trực tiếp từ file logo WIN-tech, không phải màu tự đoán -->
    <Color x:Key="MauDoWin">#FF0000</Color>
    <Color x:Key="MauXanhWin">#2E58A6</Color>
    <Color x:Key="MauXanhNhat">#4FA1CA</Color>

    <SolidColorBrush x:Key="DoWin" Color="{StaticResource MauDoWin}"/>
    <SolidColorBrush x:Key="XanhWin" Color="{StaticResource MauXanhWin}"/>
    <!-- #2E58A6 quá tối để làm chữ trên nền đen; bản sáng hơn này mới đọc được -->
    <SolidColorBrush x:Key="XanhSang" Color="#5AA9D6"/>
    <SolidColorBrush x:Key="XanhNhat" Color="{StaticResource MauXanhNhat}"/>

    <!-- Path icon dùng chung: canh giữa, nét bo tròn giống hệt bản gốc Lucide -->
    <Style x:Key="IconNet" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Fill" Value="{x:Null}"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Stroke" Value="#94A3B8"/>
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

