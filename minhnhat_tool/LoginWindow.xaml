<Window x:Class="minhnhat_tool.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập — Quản lý hóa đơn điện tử" Height="600" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#0B1020">

    <Window.Resources>
        <!-- Nút chính: xanh WIN-tech lấy từ logo, KHÔNG dùng xanh lá chung chung -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2E58A6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3A6BC4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#254A8C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ô nhập: viền sáng lên khi đang gõ, để biết con trỏ đang ở đâu -->
        <Style x:Key="ONhap" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#080D1A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="#5AA9D6"/>
            <Setter Property="BorderBrush" Value="#2C3E60"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#5AA9D6"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ONhapMk" TargetType="PasswordBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#080D1A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="#5AA9D6"/>
            <Setter Property="BorderBrush" Value="#2C3E60"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#5AA9D6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NhanO" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B9AB4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Vạch thương hiệu: đỏ sang xanh, đúng hai màu trong logo -->
        <Border Grid.Row="0" Height="4">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF0000" Offset="0"/>
                    <GradientStop Color="#2E58A6" Offset="0.55"/>
                    <GradientStop Color="#4FA1CA" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="34,0">

            <!-- Logo đặt trên nền sáng: logo đỏ/xanh trên nền đen sẽ tối và bẩn chữ -->
            <Border Background="White" CornerRadius="10" Padding="16,12"
                    HorizontalAlignment="Center" Margin="0,0,0,18">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="0" Opacity="0.5"/>
                </Border.Effect>
                <Image Source="Assets/logo-wintech.png" Width="176" Stretch="Uniform"/>
            </Border>

            <TextBlock Text="Quản lý hóa đơn điện tử" FontSize="19" FontWeight="Bold"
                       Foreground="#E8EDF6" HorizontalAlignment="Center"/>
            <TextBlock Text="Đồng bộ từ Tổng cục Thuế · Xuất Excel, PDF, XML gốc"
                       FontSize="12" Foreground="#7C8AA5" HorizontalAlignment="Center"
                       TextAlignment="Center" Margin="0,6,0,22"/>

            <!-- Khối nhập liệu tách khỏi khối thương hiệu: nhìn là biết đâu là việc phải làm -->
            <Border Background="#141E33" CornerRadius="14" Padding="22,20" BorderBrush="#243352"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="3" Opacity="0.45"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Path Style="{StaticResource IconNet}" Data="{StaticResource IcCongTy}" Width="14" Height="14"/>
                        <TextBlock Text="Mã số thuế" Style="{StaticResource NhanO}" Margin="7,0,0,0"/>
                    </StackPanel>
                    <Grid>
                        <TextBox x:Name="txtMst" Style="{StaticResource ONhap}" FontFamily="Consolas"/>
                        <!-- Gợi ý định dạng: WPF không có placeholder sẵn, tự ẩn khi ô có chữ -->
                        <TextBlock Text="0312303803" Foreground="#3E4B66" FontSize="14" FontFamily="Consolas"
                                   Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=txtMst}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,6">
                        <Path Style="{StaticResource IconNet}" Data="{StaticResource IcChiaKhoa}" Width="14" Height="14"/>
                        <TextBlock Text="Mật khẩu hoadondientu.gdt.gov.vn" Style="{StaticResource NhanO}" Margin="7,0,0,0"/>
                    </StackPanel>
                    <PasswordBox x:Name="txtPassword" Style="{StaticResource ONhapMk}"/>

                    <Button x:Name="btnLogin" Height="46" Margin="0,20,0,0" FontSize="15"
                            Style="{StaticResource BtnPrimary}" IsDefault="True" Click="btnLogin_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconNet}" Data="{StaticResource IcDangNhap}"
                                  Stroke="White" Width="17" Height="17"/>
                            <TextBlock Text="Đăng nhập" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Dòng trạng thái: icon đổi theo tình huống trong code-behind -->
            <StackPanel x:Name="pnlStatus" Orientation="Horizontal" HorizontalAlignment="Center"
                        Margin="0,18,0,0">
                <Path x:Name="icoStatus" Style="{StaticResource IconNet}" Data="{StaticResource IcKhoa}"
                      Stroke="#64748B" Width="13" Height="13" VerticalAlignment="Top" Margin="0,1,0,0"/>
                <TextBlock x:Name="txtStatus" Text="Tự động vượt captcha, không phải gõ tay"
                           Foreground="#64748B" FontSize="11" TextWrapping="Wrap" MaxWidth="330"
                           TextAlignment="Left" Margin="7,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Chân trang: sản phẩm thật thì có tên công ty và số hiệu bản -->
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="CÔNG TY TNHH WIN TECH SOLUTION" FontSize="10" Foreground="#4A5670"
                       HorizontalAlignment="Center" FontWeight="SemiBold"/>
            <TextBlock x:Name="txtPhienBan" Text="Phiên bản 1.0.0" FontSize="10" Foreground="#3C4658"
                       HorizontalAlignment="Center" Margin="0,3,0,0"/>
        </StackPanel>
    </Grid>
</Window>
